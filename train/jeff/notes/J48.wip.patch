+  for (int i = 0; i < JTP_N; i++) cudaEventCreate(&jtp_ev[i]);
+  for (int i = 0; i < 16; i++) cudaEventCreate(&jtp_pt[i]);
+  jtp_ready = 1;
+  atexit(jtp_dump);
+}
+static void jtp_mark(int i, cudaStream_t s) {
+  jtp_setup();
+  cudaEventRecord(jtp_ev[i], s);
+}
+static void jtp_point(int i, cudaStream_t s) {
+  jtp_setup();
+  cudaEventRecord(jtp_pt[i], s);
