+#define JTP_PT(i, st) do { if (jtp_on()) jtp_point((i), (st)); } while (0)
+#define JTP_ACC(slot, a, b) do { if (jtp_on()) jtp_acc((slot), (a), (b)); } while (0)
+#define JTP_ACC_PT(slot, a, b) do { if (jtp_on()) jtp_acc_pt((slot), (a), (b)); } while (0)
