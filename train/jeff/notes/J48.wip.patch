+static void jtp_acc_pt(int slot, int from, int to) {
+  float ms = 0.0f;
+  cudaEventSynchronize(jtp_pt[to]);
+  if (cudaEventElapsedTime(&ms, jtp_pt[from], jtp_pt[to]) != cudaSuccess) ms = 0.0f;
+  jtp_ms[slot] += (double)ms;
+  jtp_n[slot]++;
