+static void jtp_acc(int slot, int from, int to) {
+  float ms = 0.0f;
+  cudaEventSynchronize(jtp_ev[to]);
+  if (cudaEventElapsedTime(&ms, jtp_ev[from], jtp_ev[to]) != cudaSuccess) ms = 0.0f;
+  jtp_ms[slot] += (double)ms;
+  jtp_n[slot]++;
