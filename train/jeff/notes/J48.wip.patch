+  for (int i = 0; i < JTP_N; i++) {
+    if (i != JTP_F_ROWS && i != JTP_B_ROWS) tot += jtp_ms[i];
+    fprintf(stderr, "jtp:   %-40s %9.3f ms  %6ld calls  %8.4f ms/call%s\n", jtp_name[i], jtp_ms[i], jtp_n[i],
